{
  "name": "MyJOBS",
  "scope": "Indonesia + ASEAN",
  "strategy": "Indonesia-first, ASEAN Phase 2",
  "max_google_queries_per_run": 19,
  "regions": "Nationwide Indonesia + all 11 ASEAN member states",
  "sources": ["Google Jobs", "Loker.id", "ReliefWeb", "UN Careers", "UNDP"],
  "expiry_policy": {
    "stale_days": 7,
    "remove_when_status": ["past", "closed", "expired", "inactive"],
    "remove_when_expires_at_is_before_now": true,
    "do_not_infer_deadlines_for_sources_without_deadline": true
  },
  "asean_phase_2": {
    "enabled": true,
    "members": ["Brunei Darussalam","Cambodia","Indonesia","Lao PDR","Malaysia","Myanmar","Philippines","Singapore","Thailand","Timor-Leste","Viet Nam"],
    "strategy": "Google Jobs market query per ASEAN member; ReliefWeb remains global"
  }
}
