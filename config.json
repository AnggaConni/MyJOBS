{
  "name": "MyJOBS",
  "scope": "Indonesia",
  "strategy": "Indonesia-first",
  "max_google_queries_per_run": 8,
  "regions": "Nationwide Indonesia",
  "sources": ["Google Jobs", "Loker.id", "ReliefWeb", "UN Careers"],
  "expiry_policy": {
    "stale_days": 7,
    "remove_when_status": ["past", "closed", "expired", "inactive"],
    "remove_when_expires_at_is_before_now": true,
    "do_not_infer_deadlines_for_sources_without_deadline": true
  },
  "future_expansion": "ASEAN-ready architecture; expansion requires source, privacy and jurisdiction review"
}
